@description('Prefix for the Azure Linux Web App name. A resource-group-specific suffix is added automatically.')
@minLength(2)
@maxLength(46)
param namePrefix string = 'example-linux-webapp-scaling'

@description('Azure region for the App Service resources.')
param location string = 'mexicocentral'

@description('Name of the App Service plan.')
param hostingPlanName string = 'example-linux-scaling-plan'

@description('Whether Always On is enabled for the web app.')
param alwaysOn bool = false

@description('FTP/FTPS access mode for the web app.')
param ftpsState string = 'Disabled'

@description('Scope used for Azure-generated default hostname labels.')
param autoGeneratedDomainNameLabelScope string = 'TenantReuse'

@description('App Service plan pricing tier. Change this with skuCode to scale vertically.')
param sku string = 'Basic'

@description('App Service plan SKU code. For example, B1, S1, P1v3, or P2v3.')
param skuCode string = 'B1'

@description('Worker size ID for the App Service plan. This is another vertical scaling control.')
param workerSizeId int = 0

@description('Number of workers in the App Service plan. Increase this to scale horizontally.')
param numberOfWorkers int = 1

@description('Runtime stack for the Linux Web App, for example NODE|20-lts or DOCKER|<image>.')
param linuxFxVersion string = 'NODE|20-lts'

var webAppName = '${toLower(namePrefix)}-${uniqueString(subscription().subscriptionId, resourceGroup().id)}'

resource hostingPlan 'Microsoft.Web/serverfarms@2024-11-01' = {
  name: hostingPlanName
  location: location
  kind: 'linux'
  sku: {
    tier: sku
    name: skuCode
    capacity: numberOfWorkers
  }
  properties: {
    reserved: true
    targetWorkerCount: numberOfWorkers
    targetWorkerSizeId: workerSizeId
  }
}

resource webApp 'Microsoft.Web/sites@2024-11-01' = {
  name: webAppName
  location: location
  kind: 'app,linux'
  properties: {
    autoGeneratedDomainNameLabelScope: autoGeneratedDomainNameLabelScope
    siteConfig: {
      appSettings: []
      linuxFxVersion: linuxFxVersion
      alwaysOn: alwaysOn
      ftpsState: ftpsState
    }
    serverFarmId: hostingPlan.id
    clientAffinityEnabled: false
    httpsOnly: true
    publicNetworkAccess: 'Enabled'
  }
}

resource webAppScmPolicy 'Microsoft.Web/sites/basicPublishingCredentialsPolicies@2022-09-01' = {
  parent: webApp
  name: 'scm'
  properties: {
    allow: false
  }
}

resource webAppFtpPolicy 'Microsoft.Web/sites/basicPublishingCredentialsPolicies@2022-09-01' = {
  parent: webApp
  name: 'ftp'
  properties: {
    allow: false
  }
}

output hostingPlanResourceId string = hostingPlan.id
output webAppResourceId string = webApp.id
output defaultHostname string = webApp.properties.defaultHostName
output webAppUrl string = 'https://${webApp.properties.defaultHostName}'

