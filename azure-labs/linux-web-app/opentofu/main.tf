resource "azurerm_resource_group" "web_app_lab" {
  name     = var.resource_group_name
  location = var.location
  tags     = var.tags
}

locals {
  arm_parameters = {
    name = {
      value = var.name
    }
    location = {
      value = var.location
    }
    hostingPlanName = {
      value = var.hosting_plan_name
    }
    alwaysOn = {
      value = var.always_on
    }
    ftpsState = {
      value = var.ftps_state
    }
    autoGeneratedDomainNameLabelScope = {
      value = var.auto_generated_domain_name_label_scope
    }
    sku = {
      value = var.sku
    }
    skuCode = {
      value = var.sku_code
    }
    workerSize = {
      value = var.worker_size
    }
    workerSizeId = {
      value = var.worker_size_id
    }
    numberOfWorkers = {
      value = var.number_of_workers
    }
    linuxFxVersion = {
      value = var.linux_fx_version
    }
  }
}

resource "azurerm_resource_group_template_deployment" "web_app_lab" {
  name                = var.deployment_name
  resource_group_name = azurerm_resource_group.web_app_lab.name
  deployment_mode     = "Incremental"
  template_content    = file("${path.module}/../azuredeploy.json")
  parameters_content  = jsonencode(local.arm_parameters)
}
